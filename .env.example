# Copy to .env for local runs (`npm run status`). Never commit .env.
# In GitHub, add the same names under Settings > Secrets and variables > Actions.
# Any key left empty makes that service show "unknown" (or "ping only" when a public URL is known).

# Supabase: Personal access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Resend: an API key with "Full access" (sending-only keys cannot list domains). https://resend.com/api-keys
RESEND_API_KEY=

# Render: API key from https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=

# Vercel: token from https://vercel.com/account/tokens. Set VERCEL_TEAM_ID if the projects live in a team.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# GitHub: optional. Public repos work without it (60 requests/hour).
# For private repos or Pages build status, use a fine-grained token with read access to
# "Actions", "Pages" and "Metadata" on your game repos.
GH_STATUS_TOKEN=
